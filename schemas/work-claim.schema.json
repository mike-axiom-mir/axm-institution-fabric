{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/institution/work-claim.schema.json",
  "title": "AXM Institution Fabric Work Claim",
  "description": "Bounded coordination state for intended work against one exact immutable base revision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "lane_id",
    "base_state_revision_ref",
    "occupancy_id",
    "summary",
    "created_at",
    "status",
    "scope_refs",
    "overlap_with_claim_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "lane_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "base_state_revision_ref": {
      "type": "string",
      "pattern": "^axmref:v1:state-revision:[a-z0-9][a-z0-9._-]*:-:sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "occupancy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "submitted",
        "closed",
        "superseded"
      ]
    },
    "scope_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "overlap_with_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}
