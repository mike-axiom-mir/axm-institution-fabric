{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/institution/artifact.schema.json",
  "title": "AXM Institution Fabric Artifact",
  "description": "Typed continuation-relevant output with explicit version, provenance, evidence, and dependencies. Schema v0.1 preserves the historical logical provenance-base string; v0.2 adds an exact immutable state-revision work-base reference for created-artifact continuity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "type",
    "version",
    "content_ref",
    "provenance",
    "evidence_refs",
    "dependency_refs"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "0.1",
        "0.2"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "content_ref": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_lane_id"
      ],
      "properties": {
        "producer_lane_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "base_state_revision": {
          "type": "string",
          "minLength": 1
        },
        "base_state_revision_ref": {
          "type": "string",
          "pattern": "^axmref:v1:state-revision:[^:]+:(?:-|v=[^:]+):sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supersedes_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.1"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "base_state_revision"
            ],
            "not": {
              "required": [
                "base_state_revision_ref"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.2"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "base_state_revision_ref"
            ],
            "not": {
              "required": [
                "base_state_revision"
              ]
            }
          }
        }
      }
    }
  ]
}
