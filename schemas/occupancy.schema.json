{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axm.local/schemas/institution/occupancy.schema.json",
  "title": "AXM Institution Fabric Occupancy",
  "description": "Temporary binding between an actor and a persistent lane; lifecycle fields must be internally coherent and occupancy grants no constitutional authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "lane_id", "actor_ref", "base_state_revision", "started_at", "status", "claim_ids"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "lane_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "actor_ref": {"type": "string", "minLength": 1},
    "base_state_revision": {"type": "string", "minLength": 1},
    "capability_ref": {"type": ["string", "null"], "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"type": "string", "enum": ["active", "ended"]},
    "claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "active"}}, "required": ["status"]},
      "then": {"properties": {"ended_at": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "ended"}}, "required": ["status"]},
      "then": {"required": ["ended_at"], "properties": {"ended_at": {"type": "string", "format": "date-time"}}}
    }
  ]
}
